{
  "name": "draw-clever-architecture",
  "private": true,
  "version": "2.0.0",
  "description": "Draw Clever Architecture — luxury architecture & interior design studio.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run verify:csp",
    "build": "vite build",
    "preview": "vite preview",
    "verify:csp": "node scripts/verify-csp.mjs",
    "verify:headers": "node scripts/verify-headers.mjs",
    "check:static": "node scripts/check-static.mjs",
    "audit:tap": "node scripts/audit.mjs",
    "audit:type": "node scripts/verify.mjs",
    "audit:contrast": "node scripts/contrast.mjs",
    "audit:perf": "node scripts/perf3.mjs",
    "audit:mobile": "node scripts/audit.mjs && node scripts/verify.mjs && node scripts/contrast.mjs && node scripts/perf3.mjs",
    "verify:all": "npm run check:static && npm run verify:headers && npm run audit:mobile",
    "audit": "npm audit --omit=dev --audit-level=moderate"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "overrides": {
    "postcss": "^8.5.25"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
